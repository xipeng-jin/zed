#!/usr/bin/env bash
# Runs the terminal perf scenarios (SPEC.md §7; verification-strategy.md §6)
# on a release build: colored dump, wide-char/CJK, alt-screen churn, and
# sustained scroll, headless through the seam — first the alacritty baseline,
# then (on Linux) the same scenarios through the ghostty backend for the P8
# within-20% comparison. The fifth scenario — sustained flood through the
# full PTY seam — is script/terminal-flood-bench (landed at P4).
#
# Baseline numbers are recorded in docs/ghostty-migration/perf-baseline.md.
set -euo pipefail
cd "$(dirname "$0")/.."

cargo test -p terminal --release --lib -- --ignored --nocapture \
    differential::perf::perf_baseline

if [[ "$(uname -s)" == "Linux" ]]; then
    cargo test -p terminal --release --lib -- --ignored --nocapture \
        differential::perf::ghostty_swap::perf_swap_ghostty
fi
